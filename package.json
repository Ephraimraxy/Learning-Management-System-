    "zustand": "^4.4.7",
    "react-hot-toast": "^2.4.1",
    "recharts": "^2.10.3",
    "socket.io-client": "^4.7.2",
    "react-quill": "^2.0.0",
    "jspdf": "^2.5.1",
    "html2canvas": "^1.4.1",
    "@monaco-editor/react": "^4.6.0",
